{
  "manifest_version": 3,
  "name": "CodeHS Paster",
  "version": "2.0",
  "description": "A chromium extension to let you paste anything into codeHS, even if disabled by teacher/question.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "clipboardRead"
  ],
  "host_permissions": [
    "https://codehs.com/*",
    "https://www.khanacademy.org/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://codehs.com/*", "https://www.khanacademy.org/*"],
      "js": ["bridge.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["https://codehs.com/*"],
      "js": ["detector.js", "content.js"],
      "run_at": "document_idle",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["https://www.khanacademy.org/*"],
      "js": ["khan-blocker.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["https://www.khanacademy.org/*"],
      "js": ["detector.js", "content.js"],
      "run_at": "document_idle",
      "world": "MAIN",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "CodeHS Paster"
  }
}
